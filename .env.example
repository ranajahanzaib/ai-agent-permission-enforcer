# Local database file (SQLite)
DATABASE_URL=sqlite://ai-agent-permission-enforcer.db
# Optional local integration credential. Leave empty to generate an internal,
# unlogged credential for the scenario simulator. Do not commit real credentials.
AA_DEMO_AGENT_TOKEN=
AA_DEMO_MODE=true
# Enable only behind HTTPS; local HTTP demo keeps this false.
AA_SECURE_COOKIES=false
RUST_LOG=info
